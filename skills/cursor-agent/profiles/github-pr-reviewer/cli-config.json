{
  "version": 1,
  "permissions": {
    "allow": [
      "Read(**)",
      "Shell(gh issue view)",
      "Shell(gh pr view)",
      "Shell(gh pr diff)",
      "Shell(gh pr comment)",
      "Shell(git diff)",
      "Shell(git log)",
      "Shell(git show)",
      "Shell(git status)",
      "Shell(rg)",
      "Shell(grep)",
      "Shell(ls)",
      "Shell(head)",
      "Shell(cat)",
      "Shell(wc)"
    ],
    "deny": [
      "Write(**)",
      "Shell(gh api)",
      "Shell(gh pr review)",
      "Shell(gh pr merge)",
      "Shell(gh issue comment)",
      "Shell(gh repo)",
      "Shell(git commit)",
      "Shell(git push)",
      "Shell(git reset)",
      "Shell(git merge)",
      "Shell(git rebase)",
      "Shell(git checkout)",
      "Shell(git restore)",
      "Shell(git stash)",
      "Shell(git apply)",
      "Shell(curl)",
      "Shell(wget)"
    ]
  }
}
